{
  "name": "touchline",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:engine": "vite build --ssr src/engine/action/performance.bench.ts --outDir node_modules/.cache/bench --emptyOutDir && node node_modules/.cache/bench/performance.bench.js",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:balance": "vitest run --config vitest.balance.config.ts",
    "test:balance:group": "node scripts/balance-groups.mjs run",
    "test:balance:fast": "vitest run --config vitest.balance.config.ts --exclude \"**/action-no-dominant-tactic-*.balance.test.ts\"",
    "test:coverage": "vitest run --coverage",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:visual": "storybook build --quiet && vite build && playwright test -c playwright.visual.config.ts",
    "test:visual:update": "storybook build --quiet && vite build && playwright test -c playwright.visual.config.ts --update-snapshots",
    "test:a11y": "vite build && playwright test -c playwright.a11y.config.ts",
    "test:e2e:stories": "playwright test -c playwright.stories.config.ts",
    "test:mutation": "stryker run",
    "test:mutation:action": "stryker run stryker.action.config.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.6.8",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@swc/core": "^1.16.22",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
