{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!package-lock.json",
      "!reference",
      "!docs",
      "!scripts",
      "!KICKOFF.md",
      "!README.md",
      "!CLAUDE.md",
      "!.github"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noDefaultExport": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/engine/**", "src/game/**"],
      "plugins": ["./tools/biome/no-nondeterminism.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "DOM globals are forbidden in engine and game.",
                  "document": "DOM globals are forbidden in engine and game.",
                  "localStorage": "Browser storage belongs in platform.",
                  "indexedDB": "Browser storage belongs in platform.",
                  "navigator": "DOM globals are forbidden in engine and game."
                }
              }
            }
          }
        }
      }
    }
  ]
}
